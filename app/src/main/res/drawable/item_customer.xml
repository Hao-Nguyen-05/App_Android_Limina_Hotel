<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvCustomer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/line"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Avatar 44dp + sao VIP đè góc -->
        <FrameLayout
            android:id="@+id/flAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_gold_soft"
                android:gravity="center"
                android:textAllCaps="true"
                android:textColor="@color/gold_dark"
                android:textSize="17sp"
                app:fontFamily="@font/inter_bold"
                tools:text="K" />

            <ImageView
                android:id="@+id/ivVipStar"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:contentDescription="@string/cd_vip_customer"
                android:src="@drawable/ic_star"
                android:visibility="gone"
                app:tint="@color/gold"
                tools:visibility="visible" />
        </FrameLayout>

        <!-- Cột giữa: tên + badge VIP, liên hệ -->
        <LinearLayout
            android:id="@+id/llCustomerInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/llCustomerStat"
            app:layout_constraintStart_toEndOf="@+id/flAvatar"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCustomerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/navy"
                    android:textSize="15sp"
                    app:fontFamily="@font/inter_bold"
                    tools:text="Trần Minh Khoa" />

                <TextView
                    android:id="@+id/tvVipBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_status_gold"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/badge_vip"
                    android:textAllCaps="true"
                    android:textColor="@color/gold_dark"
                    android:textSize="10sp"
                    android:visibility="gone"
                    app:fontFamily="@font/inter_bold"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCustomerContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="11sp"
                app:fontFamily="@font/inter_regular"
                tools:text="0987 654 321 · khoa@email.com" />
        </LinearLayout>

        <!-- Cột phải: số đơn + tổng chi tiêu -->
        <LinearLayout
            android:id="@+id/llCustomerStat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvBookingCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="12sp"
                app:fontFamily="@font/inter_regular"
                tools:text="18 đơn" />

            <TextView
                android:id="@+id/tvTotalSpent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/navy"
                android:textSize="14sp"
                app:fontFamily="@font/inter_bold"
                tools:text="68.500.000đ" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>