<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvRoomType"
    style="@style/Widget.Lumina.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clRoomType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Ảnh 64x64 bo 8dp, căn giữa theo chiều dọc -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivRoomTypeImage"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@color/surface_variant"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/ShapeAppearance.Lumina.Corner8" />

        <!-- Cột phải: sửa (trên) + xóa (dưới), mỗi nút vùng chạm 48dp -->
        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_edit"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_edit"
                app:tint="@color/navy" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_delete"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_delete"
                app:tint="@color/status_red_text" />
        </LinearLayout>

        <!-- Cột giữa: tên (+ badge Ngừng) / thông số / giá -->
        <LinearLayout
            android:id="@+id/llInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/llActions"
            app:layout_constraintStart_toEndOf="@id/ivRoomTypeImage"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTypeName"
                    style="@style/TextAppearance.Lumina.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_bold"
                    android:maxLines="1"
                    android:textColor="@color/navy"
                    tools:text="Deluxe Ocean View" />

                <TextView
                    android:id="@+id/tvBadgeInactive"
                    style="@style/Widget.Lumina.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_status_gray"
                    android:text="@string/admin_room_type_badge_inactive"
                    android:textColor="@color/muted"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTypeMeta"
                style="@style/TextAppearance.Lumina.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="25m² · Tối đa 2 khách · 30 phòng" />

            <TextView
                android:id="@+id/tvTypePrice"
                style="@style/TextAppearance.Lumina.Price.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:textSize="14sp"
                tools:ignore="TextContrastCheck"
                tools:text="1.500.000đ / đêm" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>