<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    tools:theme="@style/Theme.Lumina">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- 1. Hàng đầu: logo trái — nút "Đăng ký" phải -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_logo"
                    app:tint="@color/gold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoRegister"
                    style="@style/Widget.Lumina.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_title" />
            </LinearLayout>

            <!-- 2. Tiêu đề (cách phần trên 64dp) -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:text="@string/login_welcome_title"
                android:textAppearance="@style/TextAppearance.Lumina.H1" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/login_welcome_subtitle"
                android:textAppearance="@style/TextAppearance.Lumina.BodySm" />

            <!-- 3. Form: nhãn nằm ngoài, bên trên ô nhập -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/login_label_account"
                android:textAppearance="@style/TextAppearance.Lumina.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.Lumina.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:startIconDrawable="@drawable/ic_mail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtEmail"
                    style="@style/Widget.Lumina.TextInput.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_input_52"
                    android:autofillHints="username"
                    android:hint="@string/login_hint_account"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/login_label_password"
                android:textAppearance="@style/TextAppearance.Lumina.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.Lumina.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/muted"
                app:startIconDrawable="@drawable/ic_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPassword"
                    style="@style/Widget.Lumina.TextInput.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_input_52"
                    android:autofillHints="password"
                    android:hint="@string/login_hint_password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 4. Quên mật khẩu -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnForgotPassword"
                style="@style/Widget.Lumina.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:paddingTop="0dp"
                android:paddingEnd="0dp"
                android:paddingBottom="0dp"
                android:text="@string/login_forgot_password"
                android:textSize="12sp" />

            <!-- 5. Nút đăng nhập -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/Widget.Lumina.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button_52"
                android:layout_marginTop="24dp"
                android:text="@string/login_btn_submit" />

            <!-- 6. Dải phân cách "Hoặc" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewDividerLeft"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/line" />

                <TextView
                    android:id="@+id/tvOr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="@string/login_or_divider"
                    android:textAppearance="@style/TextAppearance.Lumina.Caption"
                    android:textColor="@color/faint" />

                <View
                    android:id="@+id/viewDividerRight"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/line" />
            </LinearLayout>

            <!-- 7. Nút Google (Giai đoạn 1: chỉ là UI trình diễn) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogle"
                style="@style/Widget.Lumina.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button_52"
                android:layout_marginTop="24dp"
                android:text="@string/login_btn_google"
                app:icon="@drawable/ic_google"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@null" />

            <!-- 8. Dòng cuối: Chưa có tài khoản? Đăng ký ngay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNoAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_no_account"
                    android:textAppearance="@style/TextAppearance.Lumina.BodySm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegisterLink"
                    style="@style/Widget.Lumina.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:paddingStart="4dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="0dp"
                    android:text="@string/login_go_register"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Đẩy dòng gợi ý tài khoản demo xuống đáy màn -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvDemoHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/login_demo_hint"
                android:textAppearance="@style/TextAppearance.Lumina.Caption"
                android:textColor="@color/faint" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Vòng tải nổi giữa màn khi đang xử lý đăng nhập -->
    <ProgressBar
        android:id="@+id/pbLoading"
        style="?android:attr/progressBarStyle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/navy"
        android:visibility="gone" />

</FrameLayout>