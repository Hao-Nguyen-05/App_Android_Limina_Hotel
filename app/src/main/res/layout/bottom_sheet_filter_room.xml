<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="20dp">

    <!-- Tay cầm kéo -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_status_gray" />

    <TextView
        android:id="@+id/tvFilterTitle"
        style="@style/TextAppearance.Lumina.H2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/admin_room_filter_title" />

    <!-- Nhóm 1: LOẠI PHÒNG (chọn nhiều, chip tạo bằng code) -->
    <TextView
        android:id="@+id/tvLabelFilterType"
        style="@style/TextAppearance.Lumina.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/admin_room_label_type" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cgFilterType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp"
        app:singleSelection="false" />

    <!-- Nhóm 2: TẦNG (chọn nhiều, chip tạo bằng code) -->
    <TextView
        android:id="@+id/tvLabelFilterFloor"
        style="@style/TextAppearance.Lumina.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/admin_room_label_floor" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cgFilterFloor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp"
        app:singleSelection="false" />

    <!-- Hàng nút: Đặt lại (trái) + Áp dụng (phải) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterReset"
            style="@style/Widget.Lumina.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="@string/action_reset_filter" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterApply"
            style="@style/Widget.Lumina.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/action_apply" />
    </LinearLayout>

</LinearLayout>