<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical">

    <!-- 1. HEADER NAVY: nút quay lại + tiêu đề (paddingTop cộng inset status bar trong code) -->
    <LinearLayout
        android:id="@+id/llFormHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_navy_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="@color/surface" />

        <TextView
            android:id="@+id/tvFormTitle"
            style="@style/TextAppearance.Lumina.H1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:textColor="@color/surface"
            android:textSize="20sp"
            tools:text="Thêm loại phòng" />
    </LinearLayout>

    <!-- 2. FORM (cuộn được) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/svForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Tên loại phòng -->
            <TextView
                style="@style/TextAppearance.Lumina.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_room_type_label_name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName"
                style="@style/Widget.Lumina.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtName"
                    style="@style/Widget.Lumina.TextInput.EditText"
                    android:layout_width="match_parent"
                    android:hint="@string/admin_room_type_hint_name"
                    android:inputType="textCapWords"
                    android:maxLength="60"
                    tools:ignore="TextContrastCheck"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Mô tả (nhiều dòng) -->
            <TextView
                style="@style/TextAppearance.Lumina.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/admin_room_type_label_description" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDescription"
                style="@style/Widget.Lumina.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtDescription"
                    style="@style/Widget.Lumina.TextInput.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:hint="@string/admin_room_type_hint_description"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="4"
                    tools:ignore="TextContrastCheck"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Hàng: Diện tích | Số khách tối đa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Lumina.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/edtArea"
                        android:text="@string/admin_room_type_label_area" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilArea"
                        style="@style/Widget.Lumina.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtArea"
                            style="@style/Widget.Lumina.TextInput.EditText"
                            android:layout_width="match_parent"
                            android:inputType="number"
                            android:maxLength="4" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Lumina.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/edtMaxGuests"
                        android:text="@string/admin_room_type_label_max_guests" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilMaxGuests"
                        style="@style/Widget.Lumina.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtMaxGuests"
                            style="@style/Widget.Lumina.TextInput.EditText"
                            android:layout_width="match_parent"
                            android:inputType="number"
                            android:maxLength="2" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Hàng: Giá / đêm | Số lượng phòng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="3"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Lumina.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/edtPrice"
                        android:text="@string/admin_room_type_label_price" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPrice"
                        style="@style/Widget.Lumina.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:suffixText="@string/currency_vnd_suffix">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtPrice"
                            style="@style/Widget.Lumina.TextInput.EditText"
                            android:layout_width="match_parent"
                            android:inputType="number"
                            android:maxLength="12" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Lumina.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/edtTotalRooms"
                        android:text="@string/admin_room_type_label_total_rooms" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTotalRooms"
                        style="@style/Widget.Lumina.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtTotalRooms"
                            style="@style/Widget.Lumina.TextInput.EditText"
                            android:layout_width="match_parent"
                            android:inputType="number"
                            android:maxLength="4" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- URL ảnh + xem trước -->
            <TextView
                style="@style/TextAppearance.Lumina.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/admin_room_type_label_image_url" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilImageUrl"
                style="@style/Widget.Lumina.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtImageUrl"
                    style="@style/Widget.Lumina.TextInput.EditText"
                    android:layout_width="match_parent"
                    android:hint="@string/admin_room_type_hint_image_url"
                    android:inputType="textUri"
                    tools:ignore="TextContrastCheck"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivImagePreview"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="12dp"
                android:background="@color/surface_variant"
                android:contentDescription="@string/admin_room_type_cd_preview"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/ShapeAppearance.Lumina.Corner8"
                tools:ignore="ImageContrastCheck"
                />

            <!-- Tiện nghi (chip được thêm bằng code) -->
            <TextView
                style="@style/TextAppearance.Lumina.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/admin_room_type_label_amenities" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgAmenities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp" />

            <!-- Đang hoạt động -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Lumina.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/admin_room_type_label_active" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:contentDescription="@string/admin_room_type_label_active" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. THANH NÚT DƯỚI: Hủy | Lưu (paddingBottom cộng inset thanh điều hướng trong code) -->
    <LinearLayout
        android:id="@+id/llBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Lumina.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/action_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.Lumina.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/action_save" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>