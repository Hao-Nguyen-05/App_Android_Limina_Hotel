<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp">

        <ImageView
            android:id="@+id/ivSuccessIconCircle"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="80dp"
            android:background="@drawable/bg_circle_success"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/ivSuccessIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/status_green_text"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="@id/ivSuccessIconCircle"
            app:layout_constraintBottom_toBottomOf="@id/ivSuccessIconCircle"
            app:layout_constraintStart_toStartOf="@id/ivSuccessIconCircle"
            app:layout_constraintEnd_toEndOf="@id/ivSuccessIconCircle" />

        <TextView
            android:id="@+id/tvSuccessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/success_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/navy"
            app:layout_constraintTop_toBottomOf="@id/ivSuccessIconCircle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSuccessDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxWidth="280dp"
            android:gravity="center"
            android:text="@string/success_subtitle"
            android:textSize="13sp"
            android:textColor="@color/muted"
            app:layout_constraintWidth_max="280dp"
            app:layout_constraintTop_toBottomOf="@id/tvSuccessTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cvBookingCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvSuccessDesc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_navy_gradient"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvCodeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/success_booking_code_prefix"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textColor="@color/gold" />

                <TextView
                    android:id="@+id/tvBookingCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/playfair_display_bold"
                    android:textSize="24sp"
                    android:letterSpacing="0.05"
                    android:textColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    tools:text="#LH20250913" />

                <View
                    android:id="@+id/viewCodeDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/gold_15" />

                <TextView
                    android:id="@+id/tvRoomName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:fontFamily="@font/inter_semibold"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    tools:text="Suite Executive" />

                <TextView
                    android:id="@+id/tvDateRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:alpha="0.7"
                    tools:text="📅 20/09 → 23/09 · 3 đêm" />

                <TextView
                    android:id="@+id/tvGuestCheckIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:alpha="0.7"
                    tools:text="👤 2 khách · Check-in 14:00" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvPaidBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_green"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/success_status_paid"
                        android:textSize="11sp"
                        android:textColor="@color/status_green_text" />

                    <TextView
                        android:id="@+id/tvTotalAmount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/gold"
                        tools:text="13.824.000đ" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnViewBookings"
            style="@style/Widget.Lumina.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/success_btn_view_bookings"
            app:layout_constraintTop_toBottomOf="@id/cvBookingCode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnBackHome"
            style="@style/Widget.Lumina.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/success_btn_home"
            app:layout_constraintTop_toBottomOf="@id/btnViewBookings"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvEmailNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="@color/faint"
            tools:text="Bạn sẽ nhận được email xác nhận tại an.nguyen@email.com trong vài phút tới."
            app:layout_constraintTop_toBottomOf="@id/btnBackHome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>