<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. ẢNH BÌA -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="224dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpImages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/surface_variant" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_gravity="top"
                    android:alpha="0.3"
                    android:background="@drawable/bg_gradient_top_scrim"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:id="@+id/layoutDotIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </FrameLayout>

            <!-- 2. KHỐI THÔNG TIN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_20"
                android:paddingTop="@dimen/space_16"
                android:paddingEnd="@dimen/space_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRoomName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/navy"
                        android:textSize="20sp"
                        app:fontFamily="@font/inter_bold"
                        tools:text="Suite Executive" />

                    <TextView
                        android:id="@+id/tvTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:background="@drawable/bg_status_gold"
                        android:paddingStart="@dimen/space_8"
                        android:paddingTop="@dimen/space_4"
                        android:paddingEnd="@dimen/space_8"
                        android:paddingBottom="@dimen/space_4"
                        android:textAllCaps="true"
                        android:textColor="@color/gold_dark"
                        android:textSize="10sp"
                        app:fontFamily="@font/inter_bold"
                        tools:text="DELUXE" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivStar"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_star"
                        app:tint="@color/gold" />

                    <TextView
                        android:id="@+id/tvRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        app:fontFamily="@font/inter_bold"
                        tools:text="4.8" />

                    <TextView
                        android:id="@+id/tvReviewCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        app:fontFamily="@font/inter_regular"
                        tools:text="(89 đánh giá)" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_marginEnd="@dimen/space_8"
                        android:text="@string/room_detail_separator"
                        android:textColor="@color/faint"
                        android:textSize="12sp"
                        app:fontFamily="@font/inter_regular" />

                    <TextView
                        android:id="@+id/tvAreaFloor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        app:fontFamily="@font/inter_regular"
                        tools:text="55m² · Tầng cao" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. THẺ GIÁ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_20"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginEnd="@dimen/space_20"
                app:cardBackgroundColor="@color/cream"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="0dp"
                app:strokeColor="@color/line"
                app:strokeWidth="@dimen/stroke_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_12">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPriceLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/room_detail_price_label"
                            android:textColor="@color/muted"
                            android:textSize="11sp"
                            app:fontFamily="@font/inter_regular" />

                        <TextView
                            android:id="@+id/tvPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/navy"
                            android:textSize="22sp"
                            app:fontFamily="@font/inter_bold"
                            tools:text="4.200.000đ" />

                        <TextView
                            android:id="@+id/tvWeekendNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/room_detail_weekend_note"
                            android:textColor="@color/gold_dark"
                            android:textSize="10sp"
                            app:fontFamily="@font/inter_medium" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvOldPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/faint"
                            android:textSize="10sp"
                            android:visibility="gone"
                            app:fontFamily="@font/inter_regular"
                            tools:text="4.900.000đ"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/tvSaving"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/status_green_text"                            android:textSize="12sp"
                            android:visibility="gone"
                            app:fontFamily="@font/inter_semibold"
                            tools:text="Tiết kiệm 700K"
                            tools:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4-6. TIỆN NGHI / MÔ TẢ / THÔNG TIN QUAN TRỌNG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_20"
                android:paddingEnd="@dimen/space_20">

                <TextView
                    android:id="@+id/tvAmenityTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/room_detail_section_amenities"
                    android:textColor="@color/navy"
                    android:textSize="17sp"
                    app:fontFamily="@font/inter_bold" />

                <GridLayout
                    android:id="@+id/glAmenities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:columnCount="3" />

                <TextView
                    android:id="@+id/tvDescTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/room_detail_desc_title"
                    android:textColor="@color/navy"
                    android:textSize="17sp"
                    app:fontFamily="@font/inter_bold" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.4"
                    android:maxLines="3"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    app:fontFamily="@font/inter_regular"
                    tools:text="Suite rộng rãi với tầm nhìn toàn cảnh thành phố, phòng khách riêng biệt, bồn tắm đá cẩm thạch và dịch vụ quản gia riêng." />

                <TextView
                    android:id="@+id/btnExpandDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="@string/room_detail_expand"
                    android:textColor="@color/gold_dark"
                    android:textSize="13sp"
                    app:fontFamily="@font/inter_semibold" />

                <TextView
                    android:id="@+id/tvInfoTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/room_detail_info_title"
                    android:textColor="@color/navy"
                    android:textSize="17sp"
                    app:fontFamily="@font/inter_bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_clock"
                        app:tint="@color/muted" />

                    <TextView
                        android:id="@+id/tvCheckInOut"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/room_detail_check_in_out"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        app:fontFamily="@font/inter_regular" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_users"
                        app:tint="@color/muted" />

                    <TextView
                        android:id="@+id/tvMaxGuest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        app:fontFamily="@font/inter_regular"
                        tools:text="Sức chứa tối đa: 3 người lớn" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_check_circle"
                        app:tint="@color/muted" />

                    <TextView
                        android:id="@+id/tvCancelPolicy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/room_detail_cancel_policy"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        app:fontFamily="@font/inter_regular" />
                </LinearLayout>

                <!-- 7. ĐÁNH GIÁ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvReviewTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/room_detail_review_title"
                        android:textColor="@color/navy"
                        android:textSize="17sp"
                        app:fontFamily="@font/inter_bold" />

                    <TextView
                        android:id="@+id/btnSeeAllReviews"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:text="@string/room_detail_see_all"
                        android:textColor="@color/gold_dark"
                        android:textSize="12sp"
                        app:fontFamily="@font/inter_semibold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAvgRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/navy"
                            android:textSize="32sp"
                            app:fontFamily="@font/inter_bold"
                            tools:text="4.8" />

                        <LinearLayout
                            android:id="@+id/layoutStars"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:orientation="horizontal" />

                        <TextView
                            android:id="@+id/tvTotalReviews"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:textColor="@color/muted"
                            android:textSize="11sp"
                            app:fontFamily="@font/inter_regular"
                            tools:text="89 đánh giá" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="7"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="12dp"
                                android:layout_height="wrap_content"
                                android:text="@string/room_detail_star_label_5"
                                android:textColor="@color/muted"
                                android:textSize="11sp"
                                app:fontFamily="@font/inter_medium" />

                            <ProgressBar
                                android:id="@+id/pbStar5"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="4dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:maxHeight="4dp"
                                android:minHeight="4dp"
                                android:progressBackgroundTint="@color/line"
                                android:progressTint="@color/gold"
                                tools:progress="80" />

                            <TextView
                                android:id="@+id/tvStar5Count"
                                android:layout_width="28dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/muted"
                                android:textSize="11sp"
                                app:fontFamily="@font/inter_regular"
                                tools:text="70" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="12dp"
                                android:layout_height="wrap_content"
                                android:text="@string/room_detail_star_label_4"
                                android:textColor="@color/muted"
                                android:textSize="11sp"
                                app:fontFamily="@font/inter_medium" />

                            <ProgressBar
                                android:id="@+id/pbStar4"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="4dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:maxHeight="4dp"
                                android:minHeight="4dp"
                                android:progressBackgroundTint="@color/line"
                                android:progressTint="@color/gold"
                                tools:progress="20" />

                            <TextView
                                android:id="@+id/tvStar4Count"
                                android:layout_width="28dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/muted"
                                android:textSize="11sp"
                                app:fontFamily="@font/inter_regular"
                                tools:text="15" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="12dp"
                                android:layout_height="wrap_content"
                                android:text="@string/room_detail_star_label_3"
                                android:textColor="@color/muted"
                                android:textSize="11sp"
                                app:fontFamily="@font/inter_medium" />

                            <ProgressBar
                                android:id="@+id/pbStar3"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="4dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:maxHeight="4dp"
                                android:minHeight="4dp"
                                android:progressBackgroundTint="@color/line"
                                android:progressTint="@color/gold"
                                tools:progress="4" />

                            <TextView
                                android:id="@+id/tvStar3Count"
                                android:layout_width="28dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/muted"
                                android:textSize="11sp"
                                app:fontFamily="@font/inter_regular"
                                tools:text="3" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="12dp"
                                android:layout_height="wrap_content"
                                android:text="@string/room_detail_star_label_2"
                                android:textColor="@color/muted"
                                android:textSize="11sp"
                                app:fontFamily="@font/inter_medium" />

                            <ProgressBar
                                android:id="@+id/pbStar2"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="4dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:maxHeight="4dp"
                                android:minHeight="4dp"
                                android:progressBackgroundTint="@color/line"
                                android:progressTint="@color/gold"
                                tools:progress="1" />

                            <TextView
                                android:id="@+id/tvStar2Count"
                                android:layout_width="28dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/muted"
                                android:textSize="11sp"
                                app:fontFamily="@font/inter_regular"
                                tools:text="1" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="12dp"
                                android:layout_height="wrap_content"
                                android:text="@string/room_detail_star_label_1"
                                android:textColor="@color/muted"
                                android:textSize="11sp"
                                app:fontFamily="@font/inter_medium" />

                            <ProgressBar
                                android:id="@+id/pbStar1"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="4dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:maxHeight="4dp"
                                android:minHeight="4dp"
                                android:progressBackgroundTint="@color/line"
                                android:progressTint="@color/gold"
                                tools:progress="0" />

                            <TextView
                                android:id="@+id/tvStar1Count"
                                android:layout_width="28dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/muted"
                                android:textSize="11sp"
                                app:fontFamily="@font/inter_regular"
                                tools:text="0" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_review" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- NÚT BACK + YÊU THÍCH (đè lên ảnh, cố định) -->
    <FrameLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingStart="@dimen/space_8"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_8">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical">

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:alpha="0.2"
                android:background="@drawable/bg_circle_white"
                android:importantForAccessibility="no" />

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/room_detail_cd_back"
                android:padding="@dimen/space_12"
                app:srcCompat="@drawable/ic_back"
                app:tint="@android:color/white" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical">

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:alpha="0.2"
                android:background="@drawable/bg_circle_white"
                android:importantForAccessibility="no" />

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/room_detail_cd_favorite"
                android:padding="@dimen/space_12"
                app:srcCompat="@drawable/ic_heart"
                app:tint="@color/gold" />
        </FrameLayout>
    </FrameLayout>

    <!-- 8. THANH ĐÁY GHIM -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_20"
        android:paddingEnd="@dimen/space_20">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBottomPriceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/room_detail_bottom_price_label"
                android:textColor="@color/muted"
                android:textSize="10sp"
                app:fontFamily="@font/inter_regular" />

            <TextView
                android:id="@+id/tvBottomPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gold"
                android:textSize="18sp"
                app:fontFamily="@font/inter_bold"
                tools:text="4.200K" />

            <TextView
                android:id="@+id/tvInactiveNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/room_detail_inactive_note"
                android:textColor="@color/status_red_text"
                android:textSize="10sp"
                android:visibility="gone"
                app:fontFamily="@font/inter_medium" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookNow"
            style="@style/Widget.Lumina.Button.Gold"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_button_52"
            android:layout_marginStart="@dimen/space_16"
            android:layout_weight="6"
            android:text="@string/room_detail_btn_book" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>