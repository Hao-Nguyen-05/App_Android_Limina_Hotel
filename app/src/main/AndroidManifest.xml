<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Cần cho Glide load ảnh Unsplash -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lumina">

        <!-- Màn khởi động: điểm vào duy nhất của app -->
        <activity
            android:name=".ui.customer.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Lumina.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.customer.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.customer.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.customer.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.customer.RoomListActivity"
            android:exported="false"
            android:theme="@style/Theme.Lumina.Dark" />

        <activity
            android:name=".ui.customer.RoomDetailActivity"
            android:theme="@style/Theme.Lumina.Dark" />

        <activity
            android:name=".ui.customer.PaymentActivity"
            android:theme="@style/Theme.Lumina.Dark"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lumina" android:host="payment-return" />
                <data android:scheme="lumina" android:host="momo-return" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.customer.BookingSuccessActivity"
            android:exported="false" />

        <activity
            android:name=".ui.customer.AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.Lumina.Dark" />

        <activity
            android:name=".ui.admin.AdminMainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AddEditRoomTypeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.admin.AddEditRoomActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.admin.AdminBookingDetailActivity"
            android:exported="false" />

    </application>

</manifest>